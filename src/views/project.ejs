<%- include('./layouts/head') %>
<div id='projectPage' class='container mt-8 mx-auto'>
  <div class='grid grid-cols-3 gap-8'>
    <div class='col-span-1'>
      <ul class="project-list">
        <% data.forEach((item, index) => { %>
          <li class='<%=item.id%> rounded-xl border border-transparent' data-index="<%= index %>">
            <h5 class="project-item-text font-medium hover:text-2xl hover:cursor-pointer leading-8"><%=item.title%></h5>
          </li>
        <% }) %>
      </ul>
    </div>
    <div class='col-span-2'>
      <!-- Detail -->
       <div class="project-detail"></div>
    </div>
  </div>

  .
</div>
<script type="module" id="projectPageScript" data-helper="<%= helper.jsonStringtify(helper) %>" data="<%= helper.jsonStringtify(data) %>" src="/js/project.js" defer></script>

<%- include('./layouts/end') %>