<div class='grid grid-cols-2 is-desktop is-widescreen is-fullhd g-2'>
  <div class='col-span-1'>
    <figure class='image' style='width: 240px;'>
      <img src='/img/avt.jpg' alt='My avatar' class='is-rounded' />
    </figure>
    <br />
    <h2 class='font-semibold'>Tran Trung Hau</h2>
    <h5 class='font-normal'>Web developer</h5>
    <div class='contact space-y-1 mt-4'>
      {{#each contactInfors}}
        <div class='flex items-center {{this.key}} space-x-1'>
          <i
            class='{{this.icon}} has-text-grey bx-fw text-foreground-subtitle'
          ></i>
          {{#if this.disable}}
            <p class=''>{{this.value}}</p>
          {{else}}
            <a href='{{this.value}}'>{{#if
                this.label
              }}{{this.label}}{{else}}{{this.value}}{{/if}}</a>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>
  <div class='col-span-1'>

  </div>
</div>