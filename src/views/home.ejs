<%- include('./layouts/head') %>
<div id="homePage" class="home-page relative">
  <ul
    id="sectionIndex"
    class="fixed right-16 bottom-32 z-10 bg-primary/10 p-4 rounded-xl shadow-lg w-32"
  >
    <% sections.forEach(item => { %>
      <li>
        <a
          href="#<%=item.id%>"
          class="leading-loose text-sm text-primary hover:font-bold"
          ><%=item.title%></a
        >
      </li>
    <% }) %>
  </ul>

  <section id="overview" class="section-overview p-16" style="height: 90vh">
    <div
      class="p-16 grid grid-cols-3 border-foreground rounded-2xl bg-background shadow-xl drop-shadow-xl h-full"
    >
      <div class="col-span-2">
        <h1
          class="font-bold text-primary"
          style="font-size: 6rem; line-height: 1.1"
        >
          I'm a Web developer.
        </h1>

        <div class="description mt-16 font-xl">
          <p class="text-lg">
            Tôi từng tốt nghiệp một trường đại học với ngành công nghệ thông tin
            chuyên ngành Công nghệ phần mềm và đã có 2 năm làm việc với vị trí
            Frontend developer và UI/UX design
          </p>
          <p class="text-lg mt-2">
            Tôi muốn tạo ra những website đơn giản, tiện dụng và trải nghiệm dễ
            dàng.
          </p>
        </div>

        <div class="stacks flex items-center w-full gap-12 mt-12">
          <% stacks.forEach(item => { %>
          <div
            class="tag px-12 py-3 font-medium rounded-full border border-foreground"
          >
            <%=item.title%>
          </div>
          <% }) %>
        </div>
      </div>
      <div class="col-span-1">
        <div class="flex justify-center h-full items-center">
          <!-- <img class="rounded-xl w-60 h-auto" src="/img/avt.jpg" /> -->
        </div>
      </div>
    </div>
  </section>

  <section id="stacks">
    <div class="grid grid-cols-1 bg-primary/10 mx-16 my-8 rounded-xl">
      <% stacks.forEach((item, index) => { %>
      <div
        class="col-span-1 p-8"
      >
        <div class="grid grid-cols-3 gap-16">
          <div class="<%= index % 2 === 1 ? 'col-span-2 order-2' : 'col-span-2 order-1' %>">
            <h2 class="">
              <%=item.title%>
            </h2>

            <div
              class="flex flex-row mt-4 items-center"
            >
              <p class="text-lg font-medium">Technology:</p>
              <div class="ms-4">
                <% item.techs.forEach(tech => { %>
                <i
                  data-tooltip="<%=tech.title%>"
                  class="<%=tech.logo%> bx-lg"
                ></i>
                <% }) %>
              </div>
            </div>

            <div
              class="flex flex-row mt-4 items-center"
            >
              <p><%=item.content%></p>
            </div>
          </div>
          <div class="<%= index % 2 === 1 ? 'col-span-1 order-1' : 'col-span-1 order-2' %>">
            <img
              class="w-full"
              src="<%=item.background%>"
              alt="Logo-technology"
            />
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </section>
</div>

<%- include('./layouts/end') %>