<div id='projectPage' class='container'>
  <div class='grid grid-cols-2'>
    <div class='col-span-1'>
      <ul>
        {{#each data}}
          <li class='{{this.id}}'>
            <h2>{{this.title}}</h2>
            {{!-- <h5>{{this.subtitle}} ({{this.duration.start}} - {{this.duration.end}})</h5> --}}
          </li>
        {{/each}}
      </ul>
    </div>
    <div class='col-span-1'></div>
  </div>
</div>