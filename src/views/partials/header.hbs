<header class='d-flex justify-content-between px-8'>
  <nav class='d-flex align-items-center navbar gap-4' role="navigation" aria-label="main navigation">
    <div class="navbar-brand">
      <h1 class='text-2xl font-bold'>HauTrank2</h1>
    </div>
    <div class="navbar-start space-x-3 ml-6">
      {{#each navbars}}
        <a class="navbar-item py-2 px-3 rounded-lg hover:bg-primary/10 {{this.pageName}} {{../page}} {{#if (eq ../page this.pageName)}}text-primary font-semibold{{/if}}" href='{{#if (eq ../page this.pageName)}}#{{else}}{{this.path}}{{/if}}'>
          {{this.title}}
        </a>
      {{/each}}
    </div>
  </nav>
  <div class='col'></div>
</header>