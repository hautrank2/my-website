<div class='header'>
  <p>
    Public time:
    {{formatDate blog.createdAt ''}}, Update:
    {{formatDate blog.updatedAt 'DD/MM/YYYY'}}
  </p>
  <h2>{{blog.title}}</h2>
  <h5 class='mt-1 font-normal'>{{blog.description}}</h5>
</div>
<div class='border-t my-2'></div>
<div id='editor-result'></div>

<script
  id='blogContentScript'
  content-data='{{content}}'
  src='/js/blog/view.js'
></script>