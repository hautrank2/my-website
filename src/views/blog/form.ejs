<%- include('../layouts/head') %>
<div class="container">
  <form class="row g-3 mx-auto" style="max-width: 800px;" action='<%= isEdit ? `/admin/blog/edit/${values._id}` : '/admin/blog/new'%>' method='POST' novalidate enctype="multipart/form-data">
    <div class="field">
      <label class="label"for='title'>Title:</label>
      <div class="control">
        <input class='input' type='text' id='title' name='title' required value="<%=values.title%>" />
      </div>
      <p class="help is-danger">
        <%= formError.title %>
      </p>
    </div>
  
    <div class="field">
      <label class="label"for='description'>Description:</label>
      <div class="control">
        <textarea
          class='input'
          id='description'
          name='description'
          required
        ><%=values.description%></textarea>
      </div>
      <p class="help is-danger">
        <%=formError.description%>
      </p>
    </div class="field">
  
    <div class="field">
      <div class="file">
        <label for="formFile" class="label" class="file-label">Images</label>
        <input class="file-input" type="file" id="formFile" name="image" required />
        <span class="file-cta">
          <span class="file-icon">
            <i class="fas fa-upload"></i>
          </span>
          <span class="file-label">Choose a image...</span>
        </span>
      </div>
    </div>
  
    <% if(values.imageUrl) {%>
    <div class="img my-2">
      <img src="<%=values.imageUrl%>" alt="Blog image" width="200" height="200">
    </div>
    <input type="hidden" name="imageUrl" value="<%=values.imageUrl%>">
    <% } %>
  
    <div class="field">
      <label class="label" for="tags-input">Tags</label>
      <div id="tags-input" class="grid grid-col-2 gx-3 gy-2 flex-wrap">
        <% values.tags.forEach(tag => {%>
          <div class="tag-input col-span-1 tag-input flex space-x-2 items-center">
            <input type="text" name="tags[]" value="<%=tag%>" placeholder="Enter a tag">
            <button type="button"><i class='bx bx-trash'></i></button> 
          </div>
        <% }) %>
      </div>
      <button class="button button-secondary mt-2 is-small" type="button" onclick="addTag()">Add</button>
    </div>
  
    <div class="field actions my-2 space-x-2">
      <button type='button' variant='text'><a href=".">Cancel</a></button>
      <button type='submit' variant='primary'><%= isEdit ? 'Edit' : 'Create' %></button>
    </div>
  </form>
</div>

<script>
  function addTag() {
    const tagInputs = document.querySelector('#tags-input')
    const newTagEl = document.createElement('div');
    newTagEl.setAttribute('class', 'tag-input col-span-1 tag-input flex space-x-2 items-center');

    const inputEl = document.createElement('input');
    inputEl.setAttribute('type', 'text');
    inputEl.setAttribute('name', 'tags[]');
    inputEl.setAttribute('placeholder', 'Enter a tag');

    const buttonEl = document.createElement('button');
    buttonEl.setAttribute('type', 'button');
    buttonEl.innerHTML = "<i class='bx bx-trash'></i>";

    newTagEl.appendChild(inputEl);
    newTagEl.appendChild(buttonEl);
    
    buttonEl.addEventListener('click',  () => {
      newTagEl.remove();
    });

    tagInputs.appendChild(newTagEl)
  }
</script>    

<%- include('../layouts/end') %>